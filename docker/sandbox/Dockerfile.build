# Where untrusted BUILDS run (npm ci / npm run build on tenant dependencies and scripts).
# Just Node + npm on Debian (the same libc family as today's runtime and builds). No platform code,
# no credentials. Started only by docker/sandbox/build-launch.sh, never directly.
#
#   docker build -f docker/sandbox/Dockerfile.build -t funchole-build-sandbox:dev .
FROM node:22-bookworm-slim
ENV HOME=/tmp NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false NPM_CONFIG_AUDIT=false
WORKDIR /work
